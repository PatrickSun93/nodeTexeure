# ---------------------------------------------------------------------------
# Backend environment (Express API on port 6666)
# Copy to backend/.env. docker-compose.prod.yml loads this file too.
# Integrations degrade gracefully when left unset:
#   - AWS SES not set  -> emails are logged to the console
#   - Stripe not set   -> payment endpoints return 503
#   - AWS S3 not set   -> image uploads are stored under backend/uploads
#   - FedEx not set    -> static shipping rates
#   - SENTRY_DSN unset -> no error tracking
# ---------------------------------------------------------------------------

# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bed_texture_ecommerce
DB_USER=root
DB_PASSWORD=change_me_local_mysql_password

# Auth. Production refuses to boot with a short/placeholder JWT_SECRET.
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
# Optional separate key for CSRF tokens (defaults to JWT_SECRET)
# CSRF_SECRET=
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
# ACCESS_TOKEN_TTL=24h
# ADMIN_AUTH_COOKIE_TTL_MS=86400000
# CSRF_TOKEN_TTL_MS=86400000

# Runtime
NODE_ENV=development
PORT=6666
# Storefront origin used in emails and Stripe redirects (never the backend URL)
FRONTEND_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3005
SUPPORT_EMAIL=support@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
# Fallback sales-tax rate when tax_rates has no match (e.g. 0.08)
# TAX_RATE=

# Rate limits (skipped when NODE_ENV is development/test, or DISABLE_RATE_LIMIT=true)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5
# SHIPPING_RATE_LIMIT_MAX=20

# Error tracking (Sentry) — optional
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# LOG_LEVEL=info

# AWS S3 (product images) — optional
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# AWS SES (transactional email) — optional
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=Noirae
AWS_SES_REPLY_TO_EMAIL=support@yourdomain.com
# Email daemon tuning
# EMAIL_DAEMON_POLL_MS=5000
# EMAIL_DAEMON_BATCH_SIZE=10

# Stripe (payments) — optional, use test keys locally
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# FedEx (shipping rates) — optional, sandbox by default
FEDEX_CLIENT_ID=your-fedex-client-id-here
FEDEX_CLIENT_SECRET=your-fedex-client-secret-here
FEDEX_ACCOUNT_NUMBER=your-fedex-account-number-here
FEDEX_API_URL=https://apis-sandbox.fedex.com

# Product-copy translation script (npm run translate:content) — optional
# ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=

# Dev only: enables POST /api/database/query (SELECT-only) for admins
# ENABLE_RAW_SQL=false
