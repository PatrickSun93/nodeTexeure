# ---------------------------------------------------------------------------
# Backend environment (Express API on port 6666)
# Copy this file to backend/.env and fill in real values.
# Services degrade gracefully when a section is left as placeholders:
#   - AWS SES not set    -> emails are logged to the console
#   - Stripe not set     -> payment endpoints run in a no-op/test mode
#   - AWS S3 not set      -> image uploads fall back to local handling
# ---------------------------------------------------------------------------

# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bed_texture_ecommerce
DB_USER=root
DB_PASSWORD=change_me_local_mysql_password

# Authentication and Security  (generate strong random values, min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_KEY=change_me_32_char_min_encryption_key
SESSION_TIMEOUT=3600
REFRESH_TOKEN_TIMEOUT=604800
STRICT_IP_VALIDATION=false
HIGH_VALUE_THRESHOLD=1000.00

# Rate limiting (requests per window, per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
BLACKLISTED_IPS=

# SSL/TLS (production only)
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/certificate.crt
SSL_KEY_PATH=/path/to/private.key
SSL_CA_PATH=/path/to/ca-bundle.crt

# Runtime
NODE_ENV=development
PORT=6666
BASE_URL=http://localhost:6666

# AWS S3 (product images) — optional
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# AWS SES (transactional email) — optional
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=Bed Texture Store
AWS_SES_REPLY_TO_EMAIL=support@yourdomain.com

# Stripe (payments) — optional, use test keys locally
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# FedEx (shipping rates) — optional, sandbox by default
FEDEX_CLIENT_ID=your-fedex-client-id-here
FEDEX_CLIENT_SECRET=your-fedex-client-secret-here
FEDEX_ACCOUNT_NUMBER=your-fedex-account-number-here
FEDEX_API_URL=https://apis-sandbox.fedex.com
