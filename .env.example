# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=root
DB_PASSWORD=Aaaaaaaaa!11111
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# API Keys
API_KEY=your-api-key-here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# File Upload
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# FedEx API Configuration
FEDEX_API_URL=https://apis-sandbox.fedex.com
FEDEX_API_KEY=your_fedex_api_key
FEDEX_SECRET_KEY=your_fedex_secret_key
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number
FEDEX_METER_NUMBER=your_fedex_meter_number

# Company Information (for shipping)
COMPANY_NAME=Bed Texture Store
COMPANY_ADDRESS=123 Main Street
COMPANY_ADDRESS2=Suite 100
COMPANY_CITY=New York
COMPANY_STATE=NY
COMPANY_POSTAL_CODE=10001
COMPANY_COUNTRY_CODE=US
COMPANY_STATE_CODE=NY
COMPANY_PHONE=555-123-4567

# Development
NODE_ENV=development
PORT=3000