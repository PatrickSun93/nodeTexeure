# ---------------------------------------------------------------------------
# Frontend environment (Next.js app on port 3000)
# Copy this file to .env and fill in real values.
#
# The frontend does NOT talk to the database directly — it proxies /api/* to the
# backend (see next.config.mjs). Database and service credentials live in
# backend/.env (see backend/.env.example).
# ---------------------------------------------------------------------------

# URL of the Express backend the frontend proxies API calls to.
BACKEND_URL=http://localhost:6666
# Used only for a production `next start` build:
# PRODUCTION_BACKEND_URL=https://api.yourdomain.com

# NextAuth (session management). Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
NEXTAUTH_URL=http://localhost:3000

# Public Stripe key (safe to expose to the browser). Use a test key locally.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Node environment
NODE_ENV=development
