# Frontend (Next.js storefront) — production, multi-stage.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# The API proxy target is baked into the build; point it at the backend service.
ARG PRODUCTION_BACKEND_URL=http://backend:6666
ENV PRODUCTION_BACKEND_URL=$PRODUCTION_BACKEND_URL
# Rust API route groups (see next.config.mjs); baked in at build like the above.
ARG RUST_API_URL=
ARG RUST_API_ROUTES=
ENV RUST_API_URL=$RUST_API_URL RUST_API_ROUTES=$RUST_API_ROUTES
ENV NODE_ENV=production
RUN npm run build

FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
# NextAuth's server-side login/refresh calls read these at runtime
# (src/lib/server/apiTarget.js): same values as the proxy baked in above.
ARG RUST_API_URL=
ARG RUST_API_ROUTES=
ENV RUST_API_URL=$RUST_API_URL RUST_API_ROUTES=$RUST_API_ROUTES
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["npm", "run", "start"]
