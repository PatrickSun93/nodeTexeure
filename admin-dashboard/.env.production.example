# Production Environment Variables for Admin Dashboard

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME="Admin Dashboard - Bed Texture"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# API Configuration
NEXT_PUBLIC_API_URL=https://api.bedtexture.com
NEXT_PUBLIC_ADMIN_API_URL=https://admin-api.bedtexture.com

# Security Configuration
NEXT_PUBLIC_SECURE_COOKIES=true
NEXT_PUBLIC_CSRF_PROTECTION=true
NEXT_PUBLIC_SESSION_TIMEOUT=3600000

# SSL/TLS Configuration
NEXT_PUBLIC_FORCE_HTTPS=true
NEXT_PUBLIC_HSTS_MAX_AGE=31536000

# CORS Configuration
NEXT_PUBLIC_ALLOWED_ORIGINS=https://admin.bedtexture.com,https://bedtexture.com

# Monitoring and Logging
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_LOG_LEVEL=error
NEXT_PUBLIC_SENTRY_DSN=

# Performance Configuration
NEXT_PUBLIC_ENABLE_SW=true
NEXT_PUBLIC_CACHE_MAX_AGE=86400

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_PROFILER=false

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.bedtexture.com
NEXT_PUBLIC_ASSETS_URL=https://assets.bedtexture.com

# Database Configuration (for server-side operations)
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Redis Configuration (for caching)
REDIS_URL=
REDIS_TLS=true

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin-specific Configuration
ADMIN_SESSION_SECRET=
ADMIN_JWT_SECRET=
ADMIN_BCRYPT_ROUNDS=12
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=900000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Monitoring URLs
HEALTH_CHECK_URL=/api/health
METRICS_URL=/api/metrics
STATUS_URL=/api/status